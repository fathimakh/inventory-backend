# Port the Express server listens on
PORT=5012

# development | production  (production hides stack traces in 500 responses)
NODE_ENV=development

# Load sample inventory items into the in-memory array on startup (true | false)
SEED_DATA=true

# Allowed CORS origin(s): "*" or a comma-separated list, e.g. http://localhost:5173,http://localhost:3000
CORS_ORIGIN=*
